  "components": {
    "schemas": {
      "ApplyDto": {
        "required": [
          "adopterId",
          "applicationDate",
          "petId"
        ],
        "type": "object",
        "properties": {
          "petId": {
            "type": "integer",
            "format": "int32"
          },
          "adopterId": {
            "minLength": 1,
            "type": "string"
          },
          "motivationMessage": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "applicationDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CreatePetDto": {
        "required": [
          "name",
          "shelterId"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "breed": {
            "type": "string",
            "nullable": true
          },
          "age": {
            "maximum": 30,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "shelterId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "LoginModelDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterModelDto": {
        "required": [
          "email",
          "firstName",
          "lastName",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 32,
            "minLength": 6,
            "type": "string"
          },
          "firstName": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "lastName": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "phoneNumber": {
            "type": "string",
            "format": "tel",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateAdoptionStatusDto": {
        "required": [
          "petId",
          "status",
          "userId"
        ],
        "type": "object",
        "properties": {
          "petId": {
            "type": "integer",
            "format": "int32"
          },
          "userId": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdatePetDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "breed": {
            "type": "string",
            "nullable": true
          },
          "age": {
            "maximum": 30,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "shelterId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}